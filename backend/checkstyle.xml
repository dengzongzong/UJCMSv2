<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checkstyle 规则:基于 Google Java Style,放宽部分以兼容历史代码
  报告 phase=verify 时输出
-->
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="LineLength">
        <property name="max" value="200"/>
    </module>

    <module name="TreeWalker">
        <!-- 命名 -->
        <module name="ConstantName"/>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <module name="TypeName"/>

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>

        <!-- 风格 -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="NeedBraces"/>
        <module name="WhitespaceAround"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
        </module>

        <!-- 高危(以下都是严重级别) -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="FinalLocalVariable"/>
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="true"/>
        </module>

        <!-- ============ 禁止 Java 9+/10+/11+/16+ 特性(项目锁 Java 8) ============ -->
        <!--
          项目 pom.xml 锁 java.version=1.8,这些语法在 Java 8 下编译失败。
          checkstyle 提前拦截,避免在 IDE / CI 飘红。
        -->
        <!-- 1) List.of / Set.of / Map.of / 各种 .copyOf: 9+ -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="(?:^|[^.\w])(List|Set|Map)\.of\s*\(|(?:^|[^.\w])(List|Set|Map)\.copyOf\s*\(|(?:^|[^.\w])Map\.entry\s*\(|(?:^|[^.\w])Stream\.toList\s*\(" />
            <property name="message" value="Java 9+/10+/16+ 语法: 请改用 Arrays.asList / new HashMap / new AbstractMap.SimpleEntry / .collect(Collectors.toList())"/>
        </module>
        <!-- 2) String.isBlank / repeat / strip / stripLeading / stripTrailing: 11+ -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="\bString\.(isBlank|repeat|strip|stripLeading|stripTrailing|transform|describeConstable)\s*\(|\.\s*isBlank\s*\(|\.\s*stripLeading\s*\(|\.\s*stripTrailing\s*\(|\.\s*strip\s*\(|\.\s*repeat\s*\(" />
            <property name="message" value="Java 11+ 语法: 请改用 Apache Commons Lang / Hutool / 手写工具函数"/>
        </module>
        <!-- 3) Files.readString / readAllBytes: 7/9+ -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="\bFiles\.readString\s*\(|\bInputStream\.readAllBytes\s*\(|\bReader\.readAllChars\s*\(" />
            <property name="message" value="Java 9+ 语法: 请改用 new String(Files.readAllBytes(...))"/>
        </module>
        <!-- 4) var 关键字: 10+ (注意: 不能误判 LocalDate.of 等) -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*var\s+[a-zA-Z_]|[^a-zA-Z_]\svar\s+[a-zA-Z_][a-zA-Z0-9_]*\s*[=;]" />
            <property name="message" value="Java 10+ var 关键字: 请写完整类型"/>
        </module>
        <!-- 5) Collectors.toUnmodifiable*: 10+ -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="Collectors\.toUnmodifiable(List|Set|Map)\s*\(" />
            <property name="message" value="Java 10+ 语法: 请改用 Collectors.toList() 配合 Collections.unmodifiableXxx()"/>
        </module>
        <!-- 6) Optional.isEmpty: 11+ -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="\.isEmpty\s*\(\s*\)" />
            <property name="message" value="Optional.isEmpty 是 Java 11+: 实体/普通对象上 .isEmpty() 正常,只有 Optional.isEmpty() 是 11+"/>
        </module>
        <!-- 7) instanceof 模式变量: 16+ -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="instanceof\s+[A-Z][A-Za-z0-9_]+\s+[a-zA-Z_]" />
            <property name="message" value="Java 16+ 模式变量: 请改用 if (x instanceof X) { X y = (X) x; ... }"/>
        </module>

        <!-- 关闭几条比较严的以免被历史代码淹没 -->
        <module name="JavadocMethod">
            <property name="severity" value="ignore"/>
        </module>
    </module>
</module>
